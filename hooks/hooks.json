{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/reinject.sh",
            "args": [],
            "timeout": 10,
            "statusMessage": "규칙 주입"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-size.sh",
            "args": [],
            "timeout": 30,
            "statusMessage": "작성 규모 확인"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-components.sh",
            "args": [],
            "timeout": 30,
            "statusMessage": "컴포넌트 개수 확인"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/format.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "포맷"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/warn-components.sh",
            "args": [],
            "timeout": 30,
            "statusMessage": "구조 신호 확인"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-feedback.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "린트"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/gate-stop.sh",
            "args": [],
            "timeout": 300,
            "statusMessage": "타입체크 · 테스트"
          }
        ]
      }
    ]
  }
}
