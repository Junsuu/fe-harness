{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/reinject.sh",
            "args": [],
            "timeout": 10,
            "statusMessage": "규칙 주입"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/format.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "포맷"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/warn-size.sh",
            "args": [],
            "timeout": 30,
            "statusMessage": "분량 신호"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/warn-components.sh",
            "args": [],
            "timeout": 30,
            "statusMessage": "구조 신호 확인"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-feedback.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "린트"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/loop-trigger.sh commit",
            "args": [],
            "timeout": 120,
            "if": "Bash(git commit:*)",
            "asyncRewake": true,
            "rewakeMessage": "방금 커밋한 변경의 품질 루프 결과다. 지적을 반영하거나 미루는 이유를 남긴 뒤, 사용자의 원래 요청을 계속한다:",
            "rewakeSummary": "커밋 품질 루프",
            "statusMessage": "품질 루프 (커밋)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/loop-trigger.sh push",
            "args": [],
            "timeout": 600,
            "if": "Bash(git push:*)",
            "asyncRewake": true,
            "rewakeMessage": "푸시한 브랜치 전체의 품질 루프 결과다. 반복된 지적이 있으면 규칙 승격을 제안한 뒤, 사용자의 원래 요청을 계속한다:",
            "rewakeSummary": "푸시 품질 루프",
            "statusMessage": "품질 루프 (푸시)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/gate-stop.sh",
            "args": [],
            "timeout": 300,
            "statusMessage": "타입체크 · 테스트"
          }
        ]
      }
    ]
  }
}
